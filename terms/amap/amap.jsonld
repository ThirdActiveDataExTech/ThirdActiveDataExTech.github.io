  {
    "@id": "https://thirdactivedataextech.github.io/terms/amap/",
    "@type": [
      "http://www.w3.org/2002/07/owl#Ontology"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2025-10-02"
      }
    ],
    "http://purl.org/dc/terms/description": [
      {
        "@language": "ko",
        "@value": "W3C DCAT 3.0을 확장한 어휘. 형식이 서로 다른 원본 메타데이터를 원본 그대로 보존하면서 DCAT 공통 속성으로 표현하고, 원본 속성과 표준 속성 사이의 매핑 관계(유사도, 대표값, 근거)를 기록할 수 있게 한다."
      },
      {
        "@language": "en",
        "@value": "An extension of W3C DCAT 3.0 for representing heterogeneous source metadata in DCAT terms while preserving the original, and for recording how each original attribute maps to a standard property (similarity, preference, evidence)."
      }
    ],
    "http://purl.org/dc/terms/modified": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-10-06"
      }
    ],
    "http://purl.org/dc/terms/title": [
      {
        "@language": "ko",
        "@value": "AMAP 능동형 메타데이터 응용 프로파일"
      },
      {
        "@language": "en",
        "@value": "AMAP: Active Metadata Application Profile"
      }
    ],
    "http://purl.org/vocab/vann/preferredNamespacePrefix": [
      {
        "@value": "amap"
      }
    ],
    "http://purl.org/vocab/vann/preferredNamespaceUri": [
      {
        "@value": "https://thirdactivedataextech.github.io/terms/amap/"
      }
    ],
    "http://www.w3.org/2002/07/owl#versionInfo": [
      {
        "@value": "1.0"
      }
    ]
  },
  {
