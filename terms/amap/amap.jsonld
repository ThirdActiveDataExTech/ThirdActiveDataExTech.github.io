  {
    "@id": "https://thirdactivedataextech.github.io/terms/amap/sourcePath",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty",
      "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Path locating the attribute inside the original metadata (JSONPath for JSON, XPath for XML). A metadata entry and a column relation with the same path refer to the same attribute."
      },
      {
        "@language": "ko",
        "@value": "원본 메타데이터 안에서 속성의 위치를 가리키는 경로. JSON이면 JSONPath, XML이면 XPath 식으로 쓴다. 원본 속성 항목과 매핑 관계가 같은 경로 값으로 서로 대응된다."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "_:n5b5e877dc3cd4d4baad9220b73a07feab1"
