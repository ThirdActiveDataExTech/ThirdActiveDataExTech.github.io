@prefix amap: <https://thirdactivedataextech.github.io/terms/amap/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix adms: <http://www.w3.org/ns/adms#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix vs:   <http://www.w3.org/2003/06/sw-vocab-status/ns#> .

<https://thirdactivedataextech.github.io/terms/amap/> a owl:Ontology ;
    dct:title "AMAP: Active Metadata Application Profile"@en , "AMAP 능동형 메타데이터 응용 프로파일"@ko ;
    dct:description "W3C DCAT 3.0을 확장한 어휘. 형식이 서로 다른 원본 메타데이터를 원본 그대로 보존하면서 DCAT 공통 속성으로 표현하고, 원본 속성과 표준 속성 사이의 매핑 관계(유사도, 대표값, 근거)를 기록할 수 있게 한다."@ko ,
        "An extension of W3C DCAT 3.0 for representing heterogeneous source metadata in DCAT terms while preserving the original, and for recording how each original attribute maps to a standard property (similarity, preference, evidence)."@en ;
    vann:preferredNamespacePrefix "amap" ;
    vann:preferredNamespaceUri "https://thirdactivedataextech.github.io/terms/amap/" ;
    dct:created "2025-10-02"^^xsd:date ;
    dct:modified "2026-10-06"^^xsd:date ;
    owl:versionInfo "1.0" .

# ---- Classes ----
amap:CatalogEntry a rdfs:Class , owl:Class ;
    rdfs:label "카탈로그엔트리"@ko , "Catalog Entry"@en ;
    rdfs:comment "카탈로그에 등록된 데이터 하나를 나타내는 항목. 원본 메타데이터를 그대로 보존하면서 제목·발행자·주제 같은 공통 속성을 DCAT 어휘로 함께 표현하고, 원본 속성 항목(MetadataEntry)과 속성 매핑 관계(ColumnRelation)를 연결하는 기준이 된다."@ko , "One catalogued data item. It keeps the original metadata intact, exposes common properties (title, publisher, theme, …) in DCAT terms, and anchors the item's metadata entries and column relations."@en ;
    skos:definition "카탈로그에 등록된 데이터 하나를 나타내는 항목. 원본 메타데이터를 그대로 보존하면서 제목·발행자·주제 같은 공통 속성을 DCAT 어휘로 함께 표현하고, 원본 속성 항목(MetadataEntry)과 속성 매핑 관계(ColumnRelation)를 연결하는 기준이 된다."@ko , "One catalogued data item. It keeps the original metadata intact, exposes common properties (title, publisher, theme, …) in DCAT terms, and anchors the item's metadata entries and column relations."@en ;
    rdfs:isDefinedBy <https://thirdactivedataextech.github.io/terms/amap/> ;
    vs:term_status "testing" .

amap:MetadataEntry a rdfs:Class , owl:Class ;
    rdfs:label "메타데이터엔트리"@ko , "Metadata Entry"@en ;
    rdfs:comment "원본 메타데이터의 속성 하나. 원본 안에서의 위치(경로)와 값을 그대로 기록한다. 공통 속성으로 옮기지 못한 원본 정보도 이 항목으로 남는다."@ko , "One attribute of the original metadata, recorded with its path in the source and its value. Source information that has no standard counterpart is kept here."@en ;
    skos:definition "원본 메타데이터의 속성 하나. 원본 안에서의 위치(경로)와 값을 그대로 기록한다. 공통 속성으로 옮기지 못한 원본 정보도 이 항목으로 남는다."@ko , "One attribute of the original metadata, recorded with its path in the source and its value. Source information that has no standard counterpart is kept here."@en ;
    rdfs:isDefinedBy <https://thirdactivedataextech.github.io/terms/amap/> ;
    vs:term_status "testing" .

amap:ColumnRelation a rdfs:Class , owl:Class ;
    rdfs:label "컬럼관계"@ko , "Column Relation"@en ;
    rdfs:comment "원본 속성 하나가 어떤 표준 속성에 대응하는지를 기록한 매핑 관계. 원본 경로, 대상 표준 속성, 유사도 점수, 대표값 여부, 우선순위, 판단 근거를 담는다."@ko , "A mapping that states which standard property an original attribute corresponds to, with its source path, target property, similarity score, preference, priority and evidence."@en ;
    skos:definition "원본 속성 하나가 어떤 표준 속성에 대응하는지를 기록한 매핑 관계. 원본 경로, 대상 표준 속성, 유사도 점수, 대표값 여부, 우선순위, 판단 근거를 담는다."@ko , "A mapping that states which standard property an original attribute corresponds to, with its source path, target property, similarity score, preference, priority and evidence."@en ;
    rdfs:isDefinedBy <https://thirdactivedataextech.github.io/terms/amap/> ;
    vs:term_status "testing" .

# ---- Properties ----
amap:rawMetadata a rdf:Property , owl:DatatypeProperty ;
    rdfs:label "원본 메타데이터"@ko , "raw metadata"@en ;
    rdfs:comment "원본 메타데이터 전문. JSON, XML 등 원본 형식의 문자열을 그대로 담는다."@ko , "The complete original metadata as a literal in its native format (JSON, XML, …)."@en ;
    skos:definition "원본 메타데이터 전문. JSON, XML 등 원본 형식의 문자열을 그대로 담는다."@ko , "The complete original metadata as a literal in its native format (JSON, XML, …)."@en ;
    rdfs:domain amap:CatalogEntry ;
    rdfs:range rdfs:Literal ;
    rdfs:isDefinedBy <https://thirdactivedataextech.github.io/terms/amap/> ;
    vs:term_status "testing" .

amap:rawFormat a rdf:Property , owl:DatatypeProperty ;
    rdfs:label "원본 형식"@ko , "raw format"@en ;
    rdfs:comment "원본 메타데이터의 형식 이름. 예: Schema.org/JSON-LD, DCAT/RDF-XML, SDMX/XML."@ko , "Name of the original metadata format, e.g. Schema.org/JSON-LD, DCAT/RDF-XML, SDMX/XML."@en ;
    skos:definition "원본 메타데이터의 형식 이름. 예: Schema.org/JSON-LD, DCAT/RDF-XML, SDMX/XML."@ko , "Name of the original metadata format, e.g. Schema.org/JSON-LD, DCAT/RDF-XML, SDMX/XML."@en ;
    rdfs:domain amap:CatalogEntry ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://thirdactivedataextech.github.io/terms/amap/> ;
    vs:term_status "testing" .

amap:ingestedAt a rdf:Property , owl:DatatypeProperty ;
    rdfs:label "수집 시각"@ko , "ingested at"@en ;
    rdfs:comment "원본 메타데이터를 가져온 시각."@ko , "When the original metadata was collected."@en ;
    skos:definition "원본 메타데이터를 가져온 시각."@ko , "When the original metadata was collected."@en ;
    rdfs:domain amap:CatalogEntry ;
    rdfs:range xsd:dateTime ;
    rdfs:isDefinedBy <https://thirdactivedataextech.github.io/terms/amap/> ;
    vs:term_status "testing" .

amap:updatedAt a rdf:Property , owl:DatatypeProperty ;
    rdfs:label "갱신 시각"@ko , "updated at"@en ;
    rdfs:comment "원본 메타데이터가 마지막으로 바뀐 시각."@ko , "When the original metadata was last changed."@en ;
    skos:definition "원본 메타데이터가 마지막으로 바뀐 시각."@ko , "When the original metadata was last changed."@en ;
    rdfs:domain amap:CatalogEntry ;
    rdfs:range xsd:dateTime ;
    rdfs:isDefinedBy <https://thirdactivedataextech.github.io/terms/amap/> ;
    vs:term_status "testing" .

amap:hasMetadataEntry a rdf:Property , owl:ObjectProperty ;
    rdfs:label "메타데이터엔트리 보유"@ko , "has metadata entry"@en ;
    rdfs:comment "카탈로그엔트리가 가진 원본 속성 항목."@ko , "A metadata entry belonging to this catalog entry."@en ;
    skos:definition "카탈로그엔트리가 가진 원본 속성 항목."@ko , "A metadata entry belonging to this catalog entry."@en ;
    rdfs:domain amap:CatalogEntry ;
    rdfs:range amap:MetadataEntry ;
    rdfs:isDefinedBy <https://thirdactivedataextech.github.io/terms/amap/> ;
    owl:inverseOf amap:ofEntry ;
    vs:term_status "testing" .

amap:hasColumnRelation a rdf:Property , owl:ObjectProperty ;
    rdfs:label "컬럼관계 보유"@ko , "has column relation"@en ;
    rdfs:comment "카탈로그엔트리가 가진 속성 매핑 관계."@ko , "A column relation belonging to this catalog entry."@en ;
    skos:definition "카탈로그엔트리가 가진 속성 매핑 관계."@ko , "A column relation belonging to this catalog entry."@en ;
    rdfs:domain amap:CatalogEntry ;
    rdfs:range amap:ColumnRelation ;
    rdfs:isDefinedBy <https://thirdactivedataextech.github.io/terms/amap/> ;
    owl:inverseOf amap:forEntry ;
    vs:term_status "testing" .

amap:representsDataset a rdf:Property , owl:ObjectProperty ;
    rdfs:label "대응 데이터셋"@ko , "represents dataset"@en ;
    rdfs:comment "이 항목이 나타내는 데이터셋(dcat:Dataset)."@ko , "The dcat:Dataset this entry represents."@en ;
    skos:definition "이 항목이 나타내는 데이터셋(dcat:Dataset)."@ko , "The dcat:Dataset this entry represents."@en ;
    rdfs:domain amap:CatalogEntry ;
    rdfs:range dcat:Dataset ;
    rdfs:isDefinedBy <https://thirdactivedataextech.github.io/terms/amap/> ;
    vs:term_status "testing" .

amap:representsService a rdf:Property , owl:ObjectProperty ;
    rdfs:label "대응 데이터서비스"@ko , "represents data service"@en ;
    rdfs:comment "이 항목이 나타내는 데이터 서비스(dcat:DataService)."@ko , "The dcat:DataService this entry represents."@en ;
    skos:definition "이 항목이 나타내는 데이터 서비스(dcat:DataService)."@ko , "The dcat:DataService this entry represents."@en ;
    rdfs:domain amap:CatalogEntry ;
    rdfs:range dcat:DataService ;
    rdfs:isDefinedBy <https://thirdactivedataextech.github.io/terms/amap/> ;
    vs:term_status "testing" .

amap:ofEntry a rdf:Property , owl:ObjectProperty ;
    rdfs:label "소속 카탈로그엔트리"@ko , "of entry"@en ;
    rdfs:comment "이 원본 속성 항목이 속한 카탈로그엔트리."@ko , "The catalog entry this metadata entry belongs to."@en ;
    skos:definition "이 원본 속성 항목이 속한 카탈로그엔트리."@ko , "The catalog entry this metadata entry belongs to."@en ;
    rdfs:domain amap:MetadataEntry ;
    rdfs:range amap:CatalogEntry ;
    rdfs:isDefinedBy <https://thirdactivedataextech.github.io/terms/amap/> ;
    owl:inverseOf amap:hasMetadataEntry ;
    vs:term_status "testing" .

amap:sourcePath a rdf:Property , owl:DatatypeProperty ;
    rdfs:label "원본 경로"@ko , "source path"@en ;
    rdfs:comment "원본 메타데이터 안에서 속성의 위치를 가리키는 경로. JSON이면 JSONPath, XML이면 XPath 식으로 쓴다. 원본 속성 항목과 매핑 관계가 같은 경로 값으로 서로 대응된다."@ko , "Path locating the attribute inside the original metadata (JSONPath for JSON, XPath for XML). A metadata entry and a column relation with the same path refer to the same attribute."@en ;
    skos:definition "원본 메타데이터 안에서 속성의 위치를 가리키는 경로. JSON이면 JSONPath, XML이면 XPath 식으로 쓴다. 원본 속성 항목과 매핑 관계가 같은 경로 값으로 서로 대응된다."@ko , "Path locating the attribute inside the original metadata (JSONPath for JSON, XPath for XML). A metadata entry and a column relation with the same path refer to the same attribute."@en ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( amap:MetadataEntry amap:ColumnRelation ) ] ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://thirdactivedataextech.github.io/terms/amap/> ;
    vs:term_status "testing" .

amap:value a rdf:Property , owl:DatatypeProperty ;
    rdfs:label "원본 값"@ko , "value"@en ;
    rdfs:comment "원본 속성의 실제 값."@ko , "The actual value of the original attribute."@en ;
    skos:definition "원본 속성의 실제 값."@ko , "The actual value of the original attribute."@en ;
    rdfs:domain amap:MetadataEntry ;
    rdfs:range rdfs:Literal ;
    rdfs:isDefinedBy <https://thirdactivedataextech.github.io/terms/amap/> ;
    vs:term_status "testing" .

amap:forEntry a rdf:Property , owl:ObjectProperty ;
    rdfs:label "대상 카탈로그엔트리"@ko , "for entry"@en ;
    rdfs:comment "이 매핑 관계가 속한 카탈로그엔트리."@ko , "The catalog entry this column relation belongs to."@en ;
    skos:definition "이 매핑 관계가 속한 카탈로그엔트리."@ko , "The catalog entry this column relation belongs to."@en ;
    rdfs:domain amap:ColumnRelation ;
    rdfs:range amap:CatalogEntry ;
    rdfs:isDefinedBy <https://thirdactivedataextech.github.io/terms/amap/> ;
    owl:inverseOf amap:hasColumnRelation ;
    vs:term_status "testing" .

amap:targetProperty a rdf:Property , owl:ObjectProperty ;
    rdfs:label "매핑 대상 표준 속성"@ko , "target property"@en ;
    rdfs:comment "원본 속성이 대응되는 표준 속성. 예: dct:title, dcat:theme."@ko , "The standard property the original attribute maps to, e.g. dct:title or dcat:theme."@en ;
    skos:definition "원본 속성이 대응되는 표준 속성. 예: dct:title, dcat:theme."@ko , "The standard property the original attribute maps to, e.g. dct:title or dcat:theme."@en ;
    rdfs:domain amap:ColumnRelation ;
    rdfs:range rdf:Property ;
    rdfs:isDefinedBy <https://thirdactivedataextech.github.io/terms/amap/> ;
    vs:term_status "testing" .

amap:similarityScore a rdf:Property , owl:DatatypeProperty ;
    rdfs:label "유사도 점수"@ko , "similarity score"@en ;
    rdfs:comment "원본 속성과 표준 속성이 얼마나 같은지를 나타내는 0.0~1.0 사이의 값. 1.0은 완전히 같음, 값이 낮을수록 이름이나 구조의 차이가 크다."@ko , "How closely the original attribute matches the standard property, from 0.0 to 1.0; 1.0 means identical."@en ;
    skos:definition "원본 속성과 표준 속성이 얼마나 같은지를 나타내는 0.0~1.0 사이의 값. 1.0은 완전히 같음, 값이 낮을수록 이름이나 구조의 차이가 크다."@ko , "How closely the original attribute matches the standard property, from 0.0 to 1.0; 1.0 means identical."@en ;
    rdfs:domain amap:ColumnRelation ;
    rdfs:range xsd:decimal ;
    rdfs:isDefinedBy <https://thirdactivedataextech.github.io/terms/amap/> ;
    vs:term_status "testing" .

amap:isPreferred a rdf:Property , owl:DatatypeProperty ;
    rdfs:label "대표값 여부"@ko , "is preferred"@en ;
    rdfs:comment "같은 표준 속성에 여러 원본 속성이 대응될 때 대표값으로 쓰는 매핑이면 참. 예: 한국어 제목과 영어 제목이 모두 dct:title에 대응되면 기본 언어 쪽을 참으로 둔다."@ko , "True when, among several original attributes mapped to the same standard property, this one supplies the representative value."@en ;
    skos:definition "같은 표준 속성에 여러 원본 속성이 대응될 때 대표값으로 쓰는 매핑이면 참. 예: 한국어 제목과 영어 제목이 모두 dct:title에 대응되면 기본 언어 쪽을 참으로 둔다."@ko , "True when, among several original attributes mapped to the same standard property, this one supplies the representative value."@en ;
    rdfs:domain amap:ColumnRelation ;
    rdfs:range xsd:boolean ;
    rdfs:isDefinedBy <https://thirdactivedataextech.github.io/terms/amap/> ;
    vs:term_status "testing" .

amap:priority a rdf:Property , owl:DatatypeProperty ;
    rdfs:label "우선순위"@ko , "priority"@en ;
    rdfs:comment "같은 표준 속성에 대응되는 매핑들 사이의 순서. 숫자가 작을수록 우선한다."@ko , "Order among mappings to the same standard property; lower comes first."@en ;
    skos:definition "같은 표준 속성에 대응되는 매핑들 사이의 순서. 숫자가 작을수록 우선한다."@ko , "Order among mappings to the same standard property; lower comes first."@en ;
    rdfs:domain amap:ColumnRelation ;
    rdfs:range xsd:integer ;
    rdfs:isDefinedBy <https://thirdactivedataextech.github.io/terms/amap/> ;
    vs:term_status "testing" .

amap:evidence a rdf:Property , owl:DatatypeProperty ;
    rdfs:label "판단 근거"@ko , "evidence"@en ;
    rdfs:comment "이 매핑을 결정한 근거. 적용한 규칙이나 사전, 검토한 후보 목록, 추천과 최종 결정 내역, 규칙·모델 버전 등을 적는다."@ko , "Why this mapping was decided: rules or dictionaries applied, candidates considered, recommendation and final decision, rule/model versions."@en ;
    skos:definition "이 매핑을 결정한 근거. 적용한 규칙이나 사전, 검토한 후보 목록, 추천과 최종 결정 내역, 규칙·모델 버전 등을 적는다."@ko , "Why this mapping was decided: rules or dictionaries applied, candidates considered, recommendation and final decision, rule/model versions."@en ;
    rdfs:domain amap:ColumnRelation ;
    rdfs:range rdfs:Literal ;
    rdfs:isDefinedBy <https://thirdactivedataextech.github.io/terms/amap/> ;
    vs:term_status "testing" .
